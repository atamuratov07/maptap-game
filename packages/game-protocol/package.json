{
	"name": "@maptap/game-protocol",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./src/index.ts",
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --clean",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.ts"
		}
	},
	"sideEffects": false,
	"dependencies": {
		"@maptap/game-domain": "workspace:*",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"tsup": "^8.5.1"
	}
}
