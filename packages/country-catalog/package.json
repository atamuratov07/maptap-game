{
	"name": "@georally/country-catalog",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"check": "tsc -p tsconfig.json --noEmit"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./src/types.ts",
			"development": "./src/types.ts",
			"import": "./dist/types.js",
			"default": "./dist/types.js"
		}
	},
	"sideEffects": false,
	"dependencies": {
		"@georally/game-domain": "workspace:*"
	},
	"devDependencies": {
		"tsup": "^8.5.1"
	}
}
